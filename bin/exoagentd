#!/usr/bin/env bash
set -euo pipefail

# exoagentd — generate config and exec workerd
# For now, delegates to wrangler dev which handles config generation + workerd

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR"
exec npx wrangler dev "$@"
