{
  "name": "exoagent-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node build.mjs && concurrently \"vite\" \"sleep 1 && electron dist/main/index.cjs\"",
    "dev:web": "npm rebuild better-sqlite3 && concurrently \"vite\" \"tsx --watch main/server.ts\"",
    "build": "vite build && node build.mjs",
    "pack": "npm run build && electron-builder --config electron-builder.config.js",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.23",
    "@google-cloud/local-auth": "^3.0.1",
    "@google/generative-ai": "^0.24.1",
    "ai": "^6.0.78",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "googleapis": "^171.4.0",
    "kysely": "^0.28.11",
    "mailparser": "^3.9.3",
    "nodemailer": "^8.0.1",
    "openid-client": "^6.8.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.25.0",
    "kysely-codegen": "^0.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
