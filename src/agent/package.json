{
  "name": "exoagent-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"sleep 2 && NODE_OPTIONS='--import tsx' electron main/index.ts\"",
    "build": "vite build && node build.mjs",
    "pack": "npm run build && electron-builder --config electron-builder.config.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
