{
  "name": "exoagent",
  "type": "module",
  "version": "0.0.2",
  "private": true,
  "description": "The OS kernel to safely unleash your agents",
  "author": "Ryan Rasti <https://github.com/ryanrasti>",
  "license": "MIT",
  "scripts": {
    "dev:backend": "tsx watch src/daemon.ts",
    "dev:providers": "tsx scripts/build-providers.ts --watch",
    "dev:ui": "vite",
    "dev:workspace": "test -f \"${EXOAGENT_DIR:-__none__}/package.json\" && npm run --prefix \"$EXOAGENT_DIR\" build -- --watch || true",
    "dev": "npm run build:providers && concurrently \"npm run dev:backend\" \"npm run dev:providers\" \"npm run dev:ui\" \"npm run dev:workspace\"",
    "build:providers": "tsx scripts/build-providers.ts",
    "build:ui": "vite build",
    "build": "npm run build:providers && npm run build:ui",
    "start": "tsx src/daemon.ts",
    "typecheck": "tsgo",
    "test": "vitest --run",
    "lint": "eslint src/ examples/",
    "check": "npm run build && npm run lint && npm run test",
    "exoeval": "tsx src/cli/exoeval.ts"
  },
  "exports": {
    "./providers/*": "./src/providers/*/index.ts",
    "./bound-eval": "./src/bound-eval.ts"
  },
  "bin": {
    "exoagentd": "bin/exoagentd"
  },
  "dependencies": {
    "@endo/module-source": "^1.4.0",
    "@hono/node-server": "^1.19.12",
    "@mariozechner/pi-coding-agent": "^0.64.0",
    "@sinclair/typebox": "^0.34.49",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.16.0",
    "better-sqlite3": "^12.8.0",
    "esbuild": "^0.27.4",
    "hono": "^4.12.9",
    "loglevel": "^1.9.2",
    "matrix-js-sdk": "41.3.0-rc.0",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "secure-json-parse": "^4.1.0",
    "ses": "^1.15.0",
    "ts-blank-space": "^0.8.0",
    "ws": "^8.20.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "^7.0.0-dev.20260330.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "vite": "^7.3.1",
    "vitest": "~4.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  }
}
